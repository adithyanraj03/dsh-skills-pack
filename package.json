{
  "name": "dsh-skills-pack",
  "version": "0.1.1",
  "description": "Registers 36 bundled agent skills (research writing, LaTeX, experiments, design review, office documents, animation, Windows shell and dsh plugin conventions) as one host-only skill provider with no UI, no network calls and no telemetry of its own; skill scripts run with the user's permissions only when invoked, local skills of the same name take priority, and uninstall removes all 36.",
  "icon": "assets/icon.png",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale",
    "skills",
    "assets/icon.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test-provider.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "skills",
    "agent-skills",
    "research",
    "latex",
    "prompt-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adithyanraj03/dsh-skills-pack.git"
  },
  "homepage": "https://adithyanraj03.github.io/dsh-skills-pack/",
  "bugs": {
    "url": "https://github.com/adithyanraj03/dsh-skills-pack/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
